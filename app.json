{
  "expo": {
    "name": "Quest",
    "slug": "quest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/quest-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gathin.quest",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#006FEE",
        "foregroundImage": "./assets/quest-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gathin.quest",
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/quest-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Let Quest photograph meals you want to log.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Let Quest choose a meal photo from your gallery.",
          "cameraPermission": "Let Quest photograph meals you want to log.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/alarm.wav"
          ]
        }
      ],
      "expo-background-task",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#006FEE",
          "image": "./assets/quest-mark.png",
          "imageWidth": 190
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class androidx.work.impl.WorkDatabase_Impl { <init>(); }"
          }
        }
      ],
      "expo-font"
    ],
    "scheme": "quest"
  }
}
